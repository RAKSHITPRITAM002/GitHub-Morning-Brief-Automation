    {
      "parameters": {
        "jsCode": "\nconst repoItems = $(\"Select Top 5\").all();\nconst readmeItems = $input.all();\n\nconst repositories = repoItems.map((item, index) => {\n  const readme = readmeItems[index]?.json || {};\n\n  return {\n    ...item.json,\n    readme: {\n      name: readme.name || \"README unavailable\",\n      path: readme.path || \"\",\n      html_url: readme.html_url || \"\",\n      download_url: readme.download_url || \"\"\n    }\n  };\n});\n\nconst topRepo = repositories[0];\n\nconst report = repositories.map(repo =>\n  `${repo.rank}. ${repo.name} - ${repo.stars} stars\n${repo.description}\n${repo.url}`\n).join(\"\\n\\n\");\n\nconst message =\n  `🚀 GitHub Morning Brief\\n\\n${report}\\n\\n` +\n  `Top repository README: ${topRepo.readme.html_url || \"Unavailable\"}`;\n\nreturn [{\n  json: {\n    topRepo,\n    repositories,\n    repositoryCount: repositories.length,\n    message\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        48
      ],
      "id": "15c2f49e-0848-428f-9dda-8da59c1079be",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "\nconst response = $input.first().json;\n\nconst repositories = response.items || [];\n\nconst topFive = repositories\n  .sort((a, b) => b.stargazers_count - a.stargazers_count)\n  .slice(0, 5);\n\nreturn topFive.map((repo, index) => ({\n  json: {\n    rank: index + 1,\n    name: repo.full_name,\n    description: repo.description || \"No description available\",\n    stars: repo.stargazers_count,\n    url: repo.html_url,\n    owner: repo.owner.login,\n    repo: repo.name\n  }\n}));\n"
      },
